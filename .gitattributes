# Binary model & archive files — always LFS regardless of location
*.pkl     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.joblib  filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text
*.kmz     filter=lfs diff=lfs merge=lfs -text
*.h5      filter=lfs diff=lfs merge=lfs -text
*.keras   filter=lfs diff=lfs merge=lfs -text
*.pt      filter=lfs diff=lfs merge=lfs -text
*.pth     filter=lfs diff=lfs merge=lfs -text

# Large columnar data files — LFS only inside data/outputs/reports directories.
# docs/data/ is intentionally excluded so dashboard JSON/CSV files are stored
# as plain text and can be served directly by GitHub Pages without LFS.
data/**/*.parquet     filter=lfs diff=lfs merge=lfs -text
outputs/**/*.parquet  filter=lfs diff=lfs merge=lfs -text
data/**/*.csv         filter=lfs diff=lfs merge=lfs -text
outputs/**/*.csv      filter=lfs diff=lfs merge=lfs -text
reports/**/*.csv      filter=lfs diff=lfs merge=lfs -text
